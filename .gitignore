coverage/
*.lcov

# Python (for crossval reference, if present)
__pycache__/
*.pyc
*.pyo
.python-version

# Lockfiles — engine has zero runtime deps; we don't ship a lock
package-lock.json
yarn.lock

# Round 7 — local witness files (generated by `npm run verify`)
# CI-generated witnesses are published as workflow artifacts + release assets.
attestations/latest.json
attestations/witness-*.json

# v2.9.25 — SHA-256 sidecar files (regenerated by `npm run attest`).
# Canonical pinned values live in DAUBERT.md §3.1; sidecars are a
# mechanically-diffable convenience for local verification.
cpm-engine.js.sha256
python_reference/cpm.py.sha256

# ...but the release-evidence copies are NOT convenience sidecars. They are the
# published pin a third party verifies the shipped bytes against, and the rules
# above are bare filenames so they match at any depth and were silently
# excluding them. release-evidence/v2.9.39/cpm-engine.js.sha256 existed on disk,
# satisfied the strict gate's existsSync check, and was never published: a clean
# clone had 9 of the packet's 10 files. Un-ignore them.
!release-evidence/**/*.sha256

# Defensive secret-pattern blocklist — these should never be committed.
# Reflects the SECURITY.md scope: zero runtime deps means zero accidental
# secret material in the tree either.
*.key
*.pem
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
credentials
credentials.*
secrets
secrets.*
.netrc
.npmrc
validation/p6-comparison/P6 Capture Sheet (DB).csv
validation/p6-comparison/p6-import-log.txt
